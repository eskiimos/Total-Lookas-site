# Пример файла с переменными окружения
# Скопируйте этот файл в .env.local и заполните значения

# URL сайта (для метатегов и OpenGraph)
NEXT_PUBLIC_SITE_URL=https://totallookas.ru

# Email для уведомлений о заявках (опционально)
CONTACT_EMAIL=info@totallookas.ru

# Telegram Bot для уведомлений (опционально)
# Получить токен: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Analytics (опционально)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
